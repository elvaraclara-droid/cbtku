# ==============================================================================
# CBT SMART EXAM — Environment Variables Template
# Salin file ini menjadi .env.local untuk pengembangan lokal.
# JANGAN PERNAH mengunggah .env atau .env.local ke GitHub!
# ==============================================================================

# --- Public (aman dikirim ke browser) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="CBT SMART EXAM"

# --- Server-Only Secrets (JANGAN PERNAH diawali NEXT_PUBLIC_) ---
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
TOKEN_HASH_PEPPER=replace-with-random-64-char-hex-secret
SESSION_SIGNING_SECRET=replace-with-random-64-char-hex-secret

# --- Optional: Face Verification Provider (default OFF per exam) ---
# Jika kosong, mode verifikasi wajah menggunakan pemeriksaan kualitas gambar lokal
# + antrean verifikasi manual oleh Pengawas.
FACE_VERIFICATION_PROVIDER=local_quality_plus_supervisor
FACE_VERIFICATION_API_URL=
FACE_VERIFICATION_API_KEY=

# --- Optional: Load Testing Target (khusus staging/local, JANGAN ke produksi) ---
LOAD_TEST_TARGET_URL=http://localhost:3000
LOAD_TEST_EXAM_ID=
LOAD_TEST_SESSION_ID=
LOAD_TEST_TOKEN=
